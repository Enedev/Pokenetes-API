PORT=3000
NODE_ENV=test
SUPABASE_URL=https://your-test-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_test_publishable_key
SUPABASE_SECRET_KEY=your_test_secret_key
SUPABASE_JWKS_URL=https://your-test-project.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres:your_password@db.your-test-project.supabase.co:5432/postgres
BIBLIO_API_URL=
BIBLIO_LAST_PATH=/api/v2/books/last
BIBLIO_LIST_PATH=/api/books
HOSPITALINE_API_URL=
HOSPITALINE_LAST_PATH=/api/v2/hospitals/last
HOSPITALINE_LIST_PATH=/api/v1/hospitals
POKENETES_API_URL=http://127.0.0.1:3000
ORCHESTRATOR_PORT=3001
AWS_SQS_QUEUE_URL=
# En EKS no hace falta: el pod usa AWS_SECRETS_MANAGER_SECRET_ID=pokenetes/test
# Grafana Cloud > tu stack > OpenTelemetry > OTLP endpoint. El header es secreto.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
