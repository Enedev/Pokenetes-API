{
  "uid": "pokenetes-obs",
  "title": "Pokenetes observabilidad",
  "tags": ["pokenetes", "seguimiento-2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "text",
      "title": "Como leer este tablero",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "RED por endpoint: peticiones, errores y p95. Trazas: Explore → Tempo, servicio `pokenetes-orchestrator`, busca el span `flujo.pokenetes`, `flujo.biblio-express` y `flujo.hospitaline`. Logs: CloudWatch log group `/aws/containerinsights/pokenetes-test/application`, filtra `trace_id`."
      }
    },
    {
      "type": "timeseries",
      "title": "Peticiones por ruta",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        {
          "expr": "sum by (http_route, http_method) (rate(http_server_requests_total[5m]))",
          "legendFormat": "{{http_method}} {{http_route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errores por ruta",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        {
          "expr": "sum by (http_route, http_status_code) (rate(http_server_errors_total[5m]))",
          "legendFormat": "{{http_route}} {{http_status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia p95 (ms)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p95 {{http_route}}",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "grafanacloud-prudentscorpic", "value": "grafanacloud-prudentscorpic" }
      }
    ]
  }
}
