# Plantilla opcional (Kind/local). En EKS usamos AWS Secrets Manager: pokenetes/test.
apiVersion: v1
kind: Secret
metadata:
  name: pokenetes-secrets
  namespace: pokenetes
type: Opaque
stringData:
  SUPABASE_URL: "https://YOUR-PROJECT.supabase.co"
  SUPABASE_PUBLISHABLE_KEY: "replace-me"
  SUPABASE_SECRET_KEY: "replace-me"
  SUPABASE_JWKS_URL: "https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json"
  POKENETES_API_URL: "http://pokenetes-api"
  BIBLIO_API_URL: ""
  HOSPITALINE_API_URL: ""
  AWS_SQS_QUEUE_URL: ""
